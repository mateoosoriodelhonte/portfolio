---
interface Props {
  href: string;
  class?: string | undefined;
}

const { href, class: className } = Astro.props;
---

<a
  href={href}
  class:list={[
    "group inline-flex items-center gap-2 text-sm font-medium text-ink transition-colors hover:text-accent",
    className,
  ]}
>
  <span class="link-under"><slot /></span>
  <svg
    class="transition-transform duration-300 group-hover:translate-x-1"
    width="14"
    height="14"
    viewBox="0 0 16 16"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M2 8h11M9 3.5 13.5 8 9 12.5"></path>
  </svg>
</a>
