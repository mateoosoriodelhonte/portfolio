---
interface Props {
  number: string;
  label: string;
  title?: string | undefined;
  /** "narrow" = prose column; "wide" = full grid width */
  width?: "narrow" | "wide" | undefined;
  class?: string | undefined;
}

const { number, label, title, width = "narrow", class: className } = Astro.props;
---

<section class:list={["container-page pt-16 md:pt-24", className]}>
  <div class="reveal hairline-t pt-4">
    <p class="eyebrow">
      <span class="text-accent">{number}</span><span class="mx-1.5" aria-hidden="true">—</span>{
        label
      }
    </p>
  </div>
  <div class:list={["mt-8 md:mt-10", width === "narrow" && "max-w-[46rem]"]}>
    {
      title ? (
        <h2 class="reveal font-display text-display text-ink">{title}</h2>
      ) : (
        <h2 class="sr-only">{label}</h2>
      )
    }
    <div class:list={["case-prose", title && "mt-6"]}>
      <slot />
    </div>
  </div>
</section>
