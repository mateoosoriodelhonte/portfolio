---
import { nav, links, site, withBase } from "~/lib/site";

const year = new Date().getFullYear();
const builtAt = new Date().toISOString().slice(0, 10);
---

<footer class="hairline-t mt-28">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr]">
    <div class="max-w-sm">
      <p class="font-mono text-[0.8rem] tracking-[0.08em] text-ink">mateo osorio delhonte</p>
      <p class="mt-3 text-sm leading-relaxed text-ink-muted">
        Software engineer — reliable systems, developer tools, and grounded AI. The fastest way to
        reach me is <a href={links.linkedin} class="link-under text-ink">LinkedIn</a>.
      </p>
    </div>

    <nav aria-label="Footer">
      <p class="eyebrow mb-4">Site</p>
      <ul class="space-y-2.5 text-sm">
        {
          nav.map((item) => (
            <li>
              <a href={withBase(item.href)} class="link-under text-ink-muted hover:text-ink">
                {item.label}
              </a>
            </li>
          ))
        }
        <li>
          <a href={withBase("/resume/")} class="link-under text-ink-muted hover:text-ink">Resume</a>
        </li>
      </ul>
    </nav>

    <div>
      <p class="eyebrow mb-4">Elsewhere</p>
      <ul class="space-y-2.5 text-sm">
        <li><a href={links.github} class="link-under text-ink-muted hover:text-ink">GitHub</a></li>
        <li>
          <a href={links.linkedin} class="link-under text-ink-muted hover:text-ink">LinkedIn</a>
        </li>
        <li>
          <a href={links.appStore} class="link-under text-ink-muted hover:text-ink">App Store</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="hairline-t">
    <div
      class="container-page flex flex-col gap-2 py-5 font-mono text-[0.7rem] tracking-[0.06em] text-ink-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.name}</p>
      <p>Built with Astro · no trackers, no analytics · {builtAt}</p>
    </div>
  </div>
</footer>
