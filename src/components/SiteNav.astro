---
import { nav, site, links, withBase } from "~/lib/site";

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const isActive = (href: string) => {
  const full = `${base}${href}`;
  if (href === "/") return currentPath === full || currentPath === `${base}`;
  return currentPath.startsWith(full);
};
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-40 transition-[background-color,box-shadow] duration-300"
>
  <div class="container-page flex h-16 items-center justify-between gap-6">
    <a
      href={withBase("/")}
      class="font-mono text-[0.8rem] tracking-[0.08em] text-ink transition-colors hover:text-accent"
    >
      <span class="hidden sm:inline">mateo osorio delhonte</span>
      <span class="sm:hidden">m. osorio delhonte</span>
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-7 md:flex">
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? "page" : undefined}
            class:list={[
              "group relative text-[0.88rem] font-medium transition-colors",
              isActive(item.href) ? "text-ink" : "text-ink-muted hover:text-ink",
            ]}
          >
            {item.label}
            <span
              class:list={[
                "absolute -bottom-1.5 left-0 h-px bg-accent transition-[width] duration-300",
                isActive(item.href) ? "w-full" : "w-0 group-hover:w-full",
              ]}
              aria-hidden="true"
            />
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-1.5">
      <a
        href={links.github}
        class="hidden rounded-md p-2 text-ink-muted transition-colors hover:text-ink md:inline-flex"
        aria-label="GitHub profile"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.09.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"
          ></path>
        </svg>
      </a>
      <a
        href={links.linkedin}
        class="hidden rounded-md p-2 text-ink-muted transition-colors hover:text-ink md:inline-flex"
        aria-label="LinkedIn profile"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M4.98 3.5A2.49 2.49 0 0 1 2.5 6a2.5 2.5 0 1 1 2.48-2.5ZM4.72 8.4H.78V21.2h3.94V8.4Zm6.34 0H7.14V21.2h3.9v-6.72c0-1.77.34-3.49 2.53-3.49 2.16 0 2.19 2.03 2.19 3.6v6.61h3.91v-7.4c0-3.39-.73-6-4.69-6-1.9 0-3.18 1.05-3.7 2.04h-.06V8.4Z"
          ></path>
        </svg>
      </a>
      <button
        id="theme-toggle"
        type="button"
        class="rounded-md p-2 text-ink-muted transition-colors hover:text-ink"
        aria-label="Switch color theme"
      >
        <svg
          class="theme-icon-sun"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4.2"></circle>
          <path
            d="M12 2.8v2.2M12 19v2.2M21.2 12H19M5 12H2.8M18.5 5.5 17 7M7 17l-1.5 1.5M18.5 18.5 17 17M7 7 5.5 5.5"
          ></path>
        </svg>
        <svg
          class="theme-icon-moon"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M20.6 14.2A8.6 8.6 0 0 1 9.8 3.4a8.6 8.6 0 1 0 10.8 10.8Z"></path>
        </svg>
      </button>
      <button
        id="menu-toggle"
        type="button"
        class="relative z-50 -mr-2 inline-flex h-10 w-10 items-center justify-center rounded-md text-ink md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-line menu-line-a" aria-hidden="true"></span>
        <span class="menu-line menu-line-b" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-45 hidden bg-paper md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
>
  <div class="container-page flex h-full flex-col pt-24 pb-10">
    <nav aria-label="Primary mobile" class="flex flex-col">
      {
        nav.map((item, i) => (
          <a
            href={withBase(item.href)}
            aria-current={isActive(item.href) ? "page" : undefined}
            class="menu-item hairline-b flex items-baseline justify-between py-5 font-display text-3xl text-ink"
            style={`--menu-i:${i}`}
          >
            <span>{item.label}</span>
            {isActive(item.href) && (
              <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true" />
            )}
          </a>
        ))
      }
    </nav>
    <div class="menu-item mt-auto flex items-center gap-6" style={`--menu-i:${nav.length}`}>
      <a href={links.github} class="eyebrow link-under">GitHub</a>
      <a href={links.linkedin} class="eyebrow link-under">LinkedIn</a>
    </div>
  </div>
</div>

<style>
  #site-header.is-scrolled {
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--line);
  }

  .menu-line {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 20px;
    height: 1.5px;
    background: currentColor;
    transition:
      transform 0.35s var(--ease-swift),
      opacity 0.2s ease;
  }

  .menu-line-a {
    transform: translate(-50%, calc(-50% - 3.5px));
  }

  .menu-line-b {
    transform: translate(-50%, calc(-50% + 3.5px));
  }

  html.menu-open .menu-line-a {
    transform: translate(-50%, -50%) rotate(45deg);
  }

  html.menu-open .menu-line-b {
    transform: translate(-50%, -50%) rotate(-45deg);
  }

  html.menu-open {
    overflow: hidden;
  }

  #mobile-menu {
    opacity: 0;
    transition: opacity 0.3s var(--ease-out-quart);
  }

  html.menu-open #mobile-menu {
    display: block;
    opacity: 1;
  }

  .menu-item {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 0.5s var(--ease-out-quart),
      transform 0.5s var(--ease-out-quart);
    transition-delay: calc(var(--menu-i) * 55ms + 80ms);
  }

  html.menu-open .menu-item {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-line,
    #mobile-menu,
    .menu-item {
      transition: none;
    }
    .menu-item {
      opacity: 1;
      transform: none;
    }
  }

  /* theme icons: show the one for the theme you would switch to */
  :global([data-theme="dark"]) .theme-icon-moon {
    display: none;
  }
  :global([data-theme="light"]) .theme-icon-sun,
  :global(html:not([data-theme])) .theme-icon-sun {
    display: none;
  }
</style>
