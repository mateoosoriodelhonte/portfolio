---
import { render } from "astro:content";
import BaseLayout from "~/layouts/BaseLayout.astro";
import BaseLink from "~/components/mdx/BaseLink.astro";
import { publishedPosts, readingTime, formatDate, type Post } from "~/lib/blog";
import { withBase } from "~/lib/site";

export async function getStaticPaths() {
  const posts = await publishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const minutes = readingTime(post.body);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  publishedTime={post.data.pubDate.toISOString()}
>
  <article class="container-page pt-16 pb-10 md:pt-24">
    <div class="mx-auto max-w-[44rem]">
      <nav aria-label="Breadcrumb">
        <a
          href={withBase("/blog/")}
          class="group inline-flex items-center gap-2 font-mono text-[0.72rem] tracking-[0.14em] text-ink-faint uppercase transition-colors hover:text-ink"
        >
          <svg
            class="transition-transform duration-300 group-hover:-translate-x-0.5"
            width="12"
            height="12"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M14 8H3M7 3.5 2.5 8 7 12.5"></path>
          </svg>
          Blog
        </a>
      </nav>

      <header class="mt-10">
        <p class="eyebrow text-accent">{post.data.category}</p>
        <h1 class="mt-5 font-display text-display text-ink">
          {post.data.title}
          {post.data.draft && <span class="chip ml-3 align-middle">Draft</span>}
        </h1>
        <p class="mt-5 text-lede text-ink-muted">{post.data.description}</p>
        <p class="mt-6 font-mono text-[0.7rem] tracking-[0.1em] text-ink-faint uppercase">
          {formatDate(post.data.pubDate)}
          <span class="mx-1.5" aria-hidden="true">·</span>
          {minutes} min read
          {
            post.data.updated && (
              <>
                <span class="mx-1.5" aria-hidden="true">
                  ·
                </span>
                updated {formatDate(post.data.updated)}
              </>
            )
          }
        </p>
      </header>

      {
        toc.length >= 3 && (
          <nav aria-label="On this page" class="hairline-t hairline-b mt-10 py-5">
            <p class="eyebrow mb-3">On this page</p>
            <ol class="space-y-1.5">
              {toc.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    class="link-under text-sm text-ink-muted hover:text-ink"
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="article-prose mt-12">
        <Content components={{ a: BaseLink }} />
      </div>

      <footer class="hairline-t mt-16 pt-8">
        <p class="text-sm text-ink-muted">
          Questions or disagreements? <a
            href="https://github.com/mateoosoriodelhonte"
            class="link-under text-ink">Open an issue</a
          > on the relevant project — that’s where the best conversations about this happen.
        </p>
      </footer>
    </div>
  </article>
</BaseLayout>
