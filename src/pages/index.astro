---
import { Image } from "astro:assets";
import BaseLayout from "~/layouts/BaseLayout.astro";
import SectionHeader from "~/components/SectionHeader.astro";
import ArrowLink from "~/components/ArrowLink.astro";
import { links, withBase } from "~/lib/site";
import { project } from "~/lib/projects";
import { sandploverPrState } from "~/lib/github";
import { publishedPosts, formatDate } from "~/lib/blog";

const pr = await sandploverPrState();
const latestPosts = (await publishedPosts()).filter((p) => !p.data.draft).slice(0, 3);
const reposignal = project("reposignal");
const studyforge = project("studyforge");
const processpilot = project("processpilot");
const quiet = [project("shoppinlyst"), project("tracemark"), project("gatehouse")];
---

<BaseLayout>
  <!-- ------------------------------------------------------------- hero -->
  <section class="relative overflow-hidden">
    <div class="hero-ledger" aria-hidden="true"></div>
    <div class="hero-light" aria-hidden="true"></div>

    <div class="container-page relative">
      <div class="flex min-h-[calc(100svh-4rem)] flex-col justify-center pt-16 pb-24">
        <p class="hero-item eyebrow" style="--hero-i:0">
          <span class="hidden sm:inline"
            >Mateo Osorio Delhonte <span class="mx-2" aria-hidden="true">/</span></span
          >
          Software Engineer
        </p>

        <h1 class="mt-7 max-w-[13ch] font-display text-display-xl font-normal text-ink">
          <span class="hero-line"
            ><span class="hero-line-inner" style="--hero-i:1">Software</span></span
          >
          <span class="hero-line"
            ><span class="hero-line-inner" style="--hero-i:2"
              >that <em class="italic text-accent">shows</em></span
            ></span
          >
          <span class="hero-line"
            ><span class="hero-line-inner" style="--hero-i:3"
              >its <em class="italic">work</em>.</span
            ></span
          >
        </h1>

        <p class="hero-item mt-8 max-w-xl text-lede text-ink-muted" style="--hero-i:4">
          I build reliable systems, developer tools, and grounded AI — engineered so every claim is
          traceable, and missing data is never mistaken for failure.
        </p>

        <div class="hero-item mt-10 flex flex-wrap items-center gap-4" style="--hero-i:5">
          <a href={withBase("/work/")} class="btn btn-primary">
            View my work
            <svg
              class="btn-arrow"
              width="15"
              height="15"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M2 8h11M9 3.5 13.5 8 9 12.5"></path>
            </svg>
          </a>
          <a href={links.github} class="btn btn-ghost">GitHub</a>
        </div>

        <p
          class="hero-item mt-20 hidden font-mono text-[0.68rem] tracking-[0.14em] text-ink-faint uppercase sm:block"
          style="--hero-i:6"
        >
          Lima, PE → Utah, US · TypeScript · Python · Go · Rust · C#
        </p>
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------------- selected work -->
  <section class="container-page pt-8 pb-28 md:pb-36">
    <SectionHeader number="01" label="Selected work">
      <ArrowLink slot="aside" href={withBase("/work/")} class="hidden sm:inline-flex">
        All projects
      </ArrowLink>
    </SectionHeader>

    <!-- RepoSignal — the flagship -->
    <article class="mt-16 grid items-center gap-10 md:mt-20 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-5">
        <div class="reveal">
          <p class="eyebrow text-accent">{reposignal.domains.join(" · ")}</p>
          <h3 class="mt-4 font-display text-display text-ink">
            <a href={withBase("/work/reposignal/")} class="transition-colors hover:text-accent">
              {reposignal.name}
            </a>
          </h3>
          <p class="mt-2 font-display text-title text-ink-muted italic">
            {reposignal.tagline}
          </p>
        </div>
        <p class="reveal mt-6 max-w-md text-ink-muted" style="--reveal-i:1">
          {reposignal.summary}
        </p>
        <ul
          class="reveal mt-6 flex flex-wrap gap-x-5 gap-y-2 font-mono text-[0.7rem] tracking-[0.08em] text-ink-faint uppercase"
          style="--reveal-i:2"
        >
          {reposignal.facts.map((fact) => <li>{fact}</li>)}
        </ul>
        <div class="reveal mt-8 flex flex-wrap items-center gap-6" style="--reveal-i:3">
          <ArrowLink href={withBase("/work/reposignal/")}>Read the case study</ArrowLink>
          <a href={reposignal.demo} class="evidence-link text-sm text-ink-muted">Live demo</a>
        </div>
      </div>
      <div class="reveal lg:col-span-7" style="--reveal-i:2">
        <a href={withBase("/work/reposignal/")} aria-label="RepoSignal case study">
          <div
            class="media-frame shadow-lift transition-transform duration-500 hover:-translate-y-1"
          >
            <Image
              src={reposignal.images.analysis!}
              alt="A RepoSignal analysis of react/react: overall score 86 with seven expandable category scores and an explanation banner for unverifiable branch protection"
              widths={[480, 800, 1200, 1600]}
              sizes="(min-width: 1024px) 58vw, 92vw"
              loading="eager"
            />
          </div>
        </a>
      </div>
    </article>

    <!-- StudyForge + ProcessPilot — asymmetric pair -->
    <div class="mt-24 grid gap-x-14 gap-y-20 md:mt-32 lg:grid-cols-12">
      <article class="lg:col-span-7">
        <a
          href={withBase("/work/studyforge/")}
          aria-label="StudyForge case study"
          class="reveal block"
        >
          <div
            class="media-frame shadow-soft transition-transform duration-500 hover:-translate-y-1"
          >
            <Image
              src={studyforge.images.study!}
              alt="A StudyForge study session showing a flashcard with rating buttons that display the real interval each answer would schedule"
              widths={[480, 800, 1200]}
              sizes="(min-width: 1024px) 55vw, 92vw"
            />
          </div>
        </a>
        <div class="reveal mt-7" style="--reveal-i:1">
          <p class="eyebrow text-accent">{studyforge.domains.join(" · ")}</p>
          <h3 class="mt-3 font-display text-title text-ink">
            <a href={withBase("/work/studyforge/")} class="transition-colors hover:text-accent">
              {studyforge.name}
            </a>
          </h3>
          <p class="mt-3 max-w-lg text-ink-muted">{studyforge.summary}</p>
          <div class="mt-5">
            <ArrowLink href={withBase("/work/studyforge/")}>Case study</ArrowLink>
          </div>
        </div>
      </article>

      <article class="lg:col-span-5">
        <a
          href={withBase("/work/processpilot/")}
          aria-label="ProcessPilot case study"
          class="reveal block"
          style="--reveal-i:1"
        >
          <div
            class="media-frame shadow-soft transition-transform duration-500 hover:-translate-y-1"
          >
            <div class="media-inner overflow-hidden bg-sunken">
              <div class="window-chrome"><span></span><span></span><span></span></div>
              <div
                class="space-y-2.5 px-5 py-6 font-mono text-[0.78rem] leading-relaxed text-ink-muted"
              >
                <p><span class="text-accent">$</span> processpilot status</p>
                <p><span class="text-accent">$</span> processpilot top</p>
                <p><span class="text-accent">$</span> processpilot explain 95707</p>
                <p class="text-ink-faint">
                  # read-only by design — no kill,<br />
                  # no stop, no exec commands
                </p>
              </div>
            </div>
          </div>
        </a>
        <div class="reveal mt-7" style="--reveal-i:2">
          <p class="eyebrow text-accent">{processpilot.domains.join(" · ")}</p>
          <h3 class="mt-3 font-display text-title text-ink">
            <a href={withBase("/work/processpilot/")} class="transition-colors hover:text-accent">
              {processpilot.name}
            </a>
          </h3>
          <p class="mt-3 max-w-lg text-ink-muted">{processpilot.summary}</p>
          <div class="mt-5">
            <ArrowLink href={withBase("/work/processpilot/")}>Case study</ArrowLink>
          </div>
        </div>
      </article>
    </div>

    <!-- The quieter tier — typographic index rows -->
    <div class="mt-24 md:mt-32">
      {
        quiet.map((p, i) => (
          <a
            href={withBase(`/work/${p.slug}/`)}
            class="group reveal hairline-t grid items-baseline gap-x-6 gap-y-1 py-6 transition-colors sm:grid-cols-[8rem_1fr_auto] last:border-b last:border-line"
            style={`--reveal-i:${i}`}
          >
            <span class="font-mono text-[0.7rem] tracking-[0.1em] text-ink-faint uppercase">
              {p.domains[0]}
            </span>
            <span class="flex flex-wrap items-baseline gap-x-3">
              <span class="font-display text-title text-ink transition-colors group-hover:text-accent">
                {p.name}
              </span>
              <span class="text-sm text-ink-muted">{p.tagline}</span>
            </span>
            <svg
              class="hidden h-3.5 w-3.5 self-center text-ink-faint transition-all duration-300 group-hover:translate-x-1 group-hover:text-accent sm:block"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M2 8h11M9 3.5 13.5 8 9 12.5" />
            </svg>
          </a>
        ))
      }
      <div class="reveal mt-8 sm:hidden">
        <ArrowLink href={withBase("/work/")}>All projects</ArrowLink>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------- principles -->
  <section class="container-page pb-28 md:pb-36">
    <SectionHeader number="02" label="How I build" />
    <div class="mt-14 grid gap-x-10 gap-y-12 md:grid-cols-3">
      <div class="reveal">
        <p class="font-mono text-sm text-accent">01</p>
        <h3 class="mt-3 font-display text-title text-ink">Evidence before claims</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">
          A score you cannot audit is not worth showing.
          <a href={withBase("/work/reposignal/")} class="evidence-link">RepoSignal</a> links every number
          to the public data behind it, and
          <a href={withBase("/work/tracemark/")} class="evidence-link">TraceMark</a> refuses to save a
          quote without its source.
        </p>
      </div>
      <div class="reveal" style="--reveal-i:1">
        <p class="font-mono text-sm text-accent">02</p>
        <h3 class="mt-3 font-display text-title text-ink">Deterministic core, AI at the edges</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">
          Scores, schedules, and verdicts come from pure, tested functions.
          <a href={withBase("/work/studyforge/")} class="evidence-link">StudyForge</a> works fully with
          no AI configured — a model may explain results, never compute them.
        </p>
      </div>
      <div class="reveal" style="--reveal-i:2">
        <p class="font-mono text-sm text-accent">03</p>
        <h3 class="mt-3 font-display text-title text-ink">Honest unknowns</h3>
        <p class="mt-3 text-sm leading-relaxed text-ink-muted">
          Missing data is not evidence of failure. Unmeasured values stay
          <span class="font-mono text-[0.85em]">null</span>,
          <a href={withBase("/work/gatehouse/")} class="evidence-link">Gatehouse</a> returns
          <span class="font-mono text-[0.85em]">UNKNOWN</span> instead of guessing, and a rate with no
          sample renders as “—”, never as 0%.
        </p>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------ grounded AI -->
  <section class="hairline-t bg-surface">
    <div class="container-page py-24 md:py-32">
      <div class="grid items-center gap-12 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <SectionHeader number="03" label="Grounded AI" />
          <h2 class="reveal mt-8 font-display text-display text-ink">
            Retrieval first.<br />
            <em class="italic text-accent">Then</em> reasoning.
          </h2>
          <p class="reveal mt-6 max-w-md text-ink-muted" style="--reveal-i:1">
            AI is most useful when it can retrieve trustworthy evidence before it reasons — and when
            the system around it decides what the model is allowed to touch.
          </p>
          <div class="reveal mt-8" style="--reveal-i:2">
            <ArrowLink href={withBase("/ai/")}>How I approach AI systems</ArrowLink>
          </div>
        </div>
        <div class="reveal lg:col-span-6 lg:col-start-7" style="--reveal-i:1">
          <ol class="flow-diagram font-mono text-[0.78rem]">
            <li>Question</li>
            <li>Retrieve context — code, docs, data</li>
            <li>Rank + select evidence</li>
            <li>Model reasons over what was found</li>
            <li>Evidence-backed output</li>
            <li>Validate before anything ships</li>
          </ol>
        </div>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------- experience -->
  <section class="hairline-t">
    <div class="container-page py-24 md:py-28">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <SectionHeader number="04" label="Experience" />
        </div>
        <div class="lg:col-span-8">
          <p class="reveal max-w-2xl font-display text-title leading-snug text-ink">
            Platform engineering at <span class="text-accent">SolutionStream</span>, building
            client-facing product on the New Reward platform — React and Next.js frontends, APIs and
            PostgreSQL data systems, and the QA and release validation that keeps them trustworthy.
          </p>
          <div class="reveal mt-7" style="--reveal-i:1">
            <ArrowLink href={withBase("/experience/")}>Full experience</ArrowLink>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ------------------------------------------------------ open source -->
  <section class="hairline-t">
    <div class="container-page py-20 md:py-24">
      <div class="grid items-center gap-x-10 gap-y-6 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <SectionHeader number="05" label="Open source" />
        </div>
        <div class="lg:col-span-8">
          <a
            href={links.sandploverPr}
            class="group reveal flex flex-wrap items-baseline gap-x-4 gap-y-2"
          >
            {
              pr.state === "merged" ? (
                <span class="chip chip--go">
                  <span class="chip-dot" aria-hidden="true" />
                  PR #261 · merged
                </span>
              ) : (
                <span class="chip chip--open">
                  <span class="chip-dot" aria-hidden="true" />
                  PR #261 · {pr.state}
                </span>
              )
            }
            <span class="text-ink transition-colors group-hover:text-accent">
              sandpiper-toolchain/sandplover — NaN validation fix{
                pr.state === "open" && ", awaiting maintainer review"
              }
            </span>
          </a>
          <p class="reveal mt-4 max-w-xl text-sm text-ink-muted" style="--reveal-i:1">
            Working in codebases I don’t own, on their terms.
            <a href={withBase("/experience/#open-source")} class="link-under text-ink"
              >More on this</a
            >
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------------------- writing -->
  <section class="hairline-t">
    <div class="container-page py-20 md:py-24">
      <SectionHeader number="06" label="Writing">
        <ArrowLink slot="aside" href={withBase("/blog/")} class="hidden sm:inline-flex">
          All posts
        </ArrowLink>
      </SectionHeader>
      <div class="mt-10 grid gap-x-10 gap-y-0 md:grid-cols-3">
        {
          latestPosts.map((post, i) => (
            <a href={withBase(`/blog/${post.id}/`)} class="group reveal" style={`--reveal-i:${i}`}>
              <article class="hairline-t py-6 md:border-t-0 md:pt-1">
                <p class="font-mono text-[0.68rem] tracking-[0.1em] text-ink-faint uppercase">
                  {formatDate(post.data.pubDate)}
                </p>
                <h3 class="mt-3 font-display text-title leading-snug text-ink transition-colors group-hover:text-accent">
                  {post.data.title}
                </h3>
                <p class="mt-3 text-sm leading-relaxed text-ink-muted">{post.data.description}</p>
              </article>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ---------------------------------------------------------- closing -->
  <section class="hairline-t">
    <div class="container-page flex flex-col items-start py-28 md:py-40">
      <p class="reveal eyebrow">07 — Contact</p>
      <h2
        class="reveal mt-8 max-w-[16ch] font-display text-display-xl text-ink"
        style="--reveal-i:1"
      >
        Let’s build something <em class="italic text-accent">useful</em>.
      </h2>
      <p class="reveal mt-6 max-w-md text-ink-muted" style="--reveal-i:2">
        I’m happiest working where reliability, tooling, and product quality meet. If that’s your
        team, say hello.
      </p>
      <div class="reveal mt-10 flex flex-wrap gap-4" style="--reveal-i:3">
        <a href={links.linkedin} class="btn btn-primary">
          Reach me on LinkedIn
          <svg
            class="btn-arrow"
            width="15"
            height="15"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M3 13 13 3M5.5 3H13v7.5"></path>
          </svg>
        </a>
        <a href={links.github} class="btn btn-ghost">GitHub</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-ledger {
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      to bottom,
      transparent 0,
      transparent 95px,
      var(--line) 95px,
      var(--line) 96px
    );
    mask-image: radial-gradient(110% 85% at 32% 45%, black 0%, transparent 75%);
    opacity: 0.55;
  }

  .hero-light {
    position: absolute;
    top: -25%;
    right: -12%;
    width: 60vw;
    height: 75vh;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--accent) 5%, transparent),
      transparent 70%
    );
  }

  .hero-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }

  .hero-line-inner {
    display: block;
    transform: translateY(115%);
    animation: hero-rise 0.9s var(--ease-out-quart) forwards;
    animation-delay: calc(var(--hero-i) * 90ms + 100ms);
  }

  .hero-item {
    opacity: 0;
    transform: translateY(14px);
    animation: hero-fade 0.8s var(--ease-out-quart) forwards;
    animation-delay: calc(var(--hero-i) * 90ms + 150ms);
  }

  @keyframes hero-rise {
    to {
      transform: translateY(0);
    }
  }

  @keyframes hero-fade {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-line-inner,
    .hero-item {
      animation: none;
      transform: none;
      opacity: 1;
    }
  }

  /* grounded-AI flow: vertical rail with nodes */
  .flow-diagram {
    position: relative;
    padding-left: 1.75rem;
  }

  .flow-diagram::before {
    content: "";
    position: absolute;
    left: 0.5rem;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 1px;
    background: var(--line-strong);
  }

  .flow-diagram li {
    position: relative;
    padding: 0.65rem 0;
    color: var(--ink-muted);
  }

  .flow-diagram li::before {
    content: "";
    position: absolute;
    left: -1.75rem;
    top: 50%;
    transform: translate(0.27rem, -50%);
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    border: 1px solid var(--line-strong);
    background: var(--paper);
  }

  .flow-diagram li:nth-child(5)::before {
    background: var(--accent);
    border-color: var(--accent);
  }

  .flow-diagram li:nth-child(5) {
    color: var(--ink);
  }
</style>
