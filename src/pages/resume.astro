---
// The resume is Mateo's actual PDF, served statically. This route only
// exists so old /resume/ links keep working — it forwards to the file.
const target = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/Mateo-Osorio-Delhonte-Resume.pdf`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <meta name="robots" content="noindex" />
    <title>Resume — Mateo Osorio Delhonte</title>
  </head>
  <body>
    <p>Opening the resume… <a href={target}>Download the PDF</a> if nothing happens.</p>
  </body>
</html>
