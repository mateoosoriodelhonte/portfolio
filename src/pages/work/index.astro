---
import BaseLayout from "~/layouts/BaseLayout.astro";
import { projects, domains } from "~/lib/projects";
import { withBase } from "~/lib/site";

const title = "Work";
const description =
  "Selected projects by Mateo Osorio Delhonte: production web platforms, developer tools, systems software, browser extensions, and a shipped iOS app.";
---

<BaseLayout title={title} description={description}>
  <section class="container-page pt-20 pb-28 md:pt-28 md:pb-36">
    <p class="eyebrow">Work</p>
    <h1 class="mt-6 max-w-3xl font-display text-display-xl text-ink">
      Six projects, six <em class="italic text-accent">verifiable</em> claims.
    </h1>
    <p class="mt-6 max-w-xl text-lede text-ink-muted">
      Every project here is public — a repository you can read, a demo you can try, or an app you
      can install. Filter by the kind of engineering you care about.
    </p>

    <!-- filter -->
    <div
      id="work-filter"
      class="mt-14 flex flex-wrap gap-2"
      role="group"
      aria-label="Filter projects by domain"
    >
      <button type="button" data-domain="all" aria-pressed="true" class="filter-pill"> All </button>
      {
        domains.map((d) => (
          <button type="button" data-domain={d} aria-pressed="false" class="filter-pill">
            {d}
          </button>
        ))
      }
    </div>

    <!-- index rows -->
    <div id="work-list" class="mt-10">
      {
        projects.map((p, i) => (
          <a
            href={withBase(`/work/${p.slug}/`)}
            data-domains={p.domains.join("|")}
            class="work-row group hairline-t grid gap-x-8 gap-y-2 py-8 last:border-b last:border-line md:grid-cols-[3rem_1fr_16rem_auto] md:items-baseline"
          >
            <span class="hidden font-mono text-[0.7rem] text-ink-faint md:block">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span>
              <span class="flex flex-wrap items-baseline gap-x-4">
                <span class="font-display text-title text-ink transition-colors group-hover:text-accent">
                  {p.name}
                </span>
                <span class="font-mono text-[0.62rem] tracking-[0.14em] text-ink-faint uppercase">
                  {p.domains.join(" · ")}
                </span>
              </span>
              <span class="mt-2 block max-w-xl text-sm leading-relaxed text-ink-muted">
                {p.summary}
              </span>
            </span>
            <span class="hidden flex-wrap content-start gap-x-3 gap-y-1 font-mono text-[0.68rem] text-ink-faint md:flex">
              {p.stack.slice(0, 4).map((s) => (
                <span>{s}</span>
              ))}
            </span>
            <svg
              class="hidden h-4 w-4 self-center text-ink-faint transition-all duration-300 group-hover:translate-x-1 group-hover:text-accent md:block"
              viewBox="0 0 16 16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M2 8h11M9 3.5 13.5 8 9 12.5" />
            </svg>
          </a>
        ))
      }
      <p id="work-empty" class="hidden py-16 text-center text-sm text-ink-muted">
        Nothing in this domain yet.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .filter-pill {
    font-family: var(--font-geist-mono), ui-monospace, monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.45rem 0.95rem;
    border-radius: 9999px;
    border: 1px solid var(--line-strong);
    color: var(--ink-muted);
    transition:
      color 0.2s var(--ease-out-quart),
      border-color 0.2s var(--ease-out-quart),
      background-color 0.2s var(--ease-out-quart);
  }

  .filter-pill:hover {
    color: var(--ink);
    border-color: var(--ink);
  }

  .filter-pill[aria-pressed="true"] {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }

  .work-row.is-hidden {
    display: none;
  }
</style>

<script>
  function initFilter() {
    const container = document.querySelector("#work-filter");
    if (!container || container.hasAttribute("data-ready")) return;
    container.setAttribute("data-ready", "");

    const pills = container.querySelectorAll<HTMLButtonElement>(".filter-pill");
    const rows = document.querySelectorAll<HTMLElement>(".work-row");
    const empty = document.querySelector<HTMLElement>("#work-empty");

    function apply(domain: string) {
      let visible = 0;
      rows.forEach((row) => {
        const match = domain === "all" || (row.dataset.domains ?? "").split("|").includes(domain);
        row.classList.toggle("is-hidden", !match);
        if (match) visible += 1;
      });
      empty?.classList.toggle("hidden", visible > 0);
      pills.forEach((pill) =>
        pill.setAttribute("aria-pressed", String(pill.dataset.domain === domain)),
      );
    }

    container.addEventListener("click", (event) => {
      const pill = (event.target as HTMLElement).closest<HTMLButtonElement>(".filter-pill");
      if (pill?.dataset.domain) apply(pill.dataset.domain);
    });

    const requested = new URLSearchParams(location.search).get("domain");
    if (requested) apply(requested);
  }

  initFilter();
  document.addEventListener("astro:page-load", initFilter);
</script>
