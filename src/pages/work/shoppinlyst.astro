---
import { Image } from "astro:assets";
import CaseStudyLayout from "~/layouts/CaseStudyLayout.astro";
import CaseSection from "~/components/CaseSection.astro";
import { project } from "~/lib/projects";

const p = project("shoppinlyst");

const phones = [
  {
    image: p.images.listsDark!,
    alt: "ShoppinLyst in dark mode: eight lists including Groceries, Pantry, Wishlist and custom ones, each with item counts and progress bars",
    caption: "Lists with progress",
  },
  {
    image: p.images.recipesDark!,
    alt: "ShoppinLyst's Recipes tab filtering breakfast recipes — pancakes, french toast, omelette — each with an ingredient count ready to add to a list",
    caption: "Recipes become shopping items",
  },
  {
    image: p.images.pricesDark!,
    alt: "ShoppinLyst's Store Prices screen listing nearby Utah stores — Bella's Market in Vineyard, Costco Wholesale in Lehi — with website and search links",
    caption: "Store links in one place",
  },
];

const spec = [
  ["Platform", "iOS 18.2 or later"],
  ["Category", "Productivity"],
  ["Price", "Free"],
  ["Current version", "2.1"],
  ["Download size", "0.8 MB"],
  ["First released", "August 2025"],
  ["Rating", "5.0 — from 6 ratings"],
];
---

<CaseStudyLayout
  slug="shoppinlyst"
  description="ShoppinLyst is a shipped iOS app on the App Store: shopping lists with priorities and notes, nearby grocery stores on a map, store links, and recipes that become shopping items. Built with Swift and SwiftUI."
>
  <!-- phone row -->
  <div class="container-page overflow-hidden">
    <div class="mx-auto grid max-w-4xl grid-cols-1 items-end gap-8 sm:grid-cols-3 sm:gap-6">
      {
        phones.map((phone, i) => (
          <figure
            class:list={["reveal", i === 1 && "sm:-translate-y-6", i !== 1 && "hidden sm:block"]}
            style={`--reveal-i:${i}`}
          >
            <div class="phone shadow-lift">
              <Image
                src={phone.image}
                alt={phone.alt}
                widths={[320, 480, 720]}
                sizes="(min-width: 640px) 30vw, 88vw"
                loading="eager"
              />
            </div>
            <figcaption class="case-caption text-center">{phone.caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>

  <CaseSection number="01" label="The product" title="The boring part of cooking is the list.">
    <p>
      ShoppinLyst is a small, fast iOS app that keeps grocery planning in one place: lists with
      priorities, quantities, units and notes; a map of nearby grocery stores with distances and
      directions; store links for checking what’s available; and a recipes feature that adds what a
      dish needs straight to your list.
    </p>
    <p>
      Unlike the engineering tools elsewhere on this site, this one is a <strong
        >shipped consumer product</strong
      > — designed, built, reviewed by Apple, and maintained through real releases since 2025. The 2.x
      series added the Recipes tab; version 2.1 shipped in August 2026.
    </p>
  </CaseSection>

  <CaseSection number="02" label="Around the app" width="wide">
    <div class="mx-auto grid max-w-2xl grid-cols-2 items-start gap-6 sm:gap-10">
      <figure class="reveal">
        <div class="phone shadow-soft">
          <Image
            src={p.images.nearby!}
            alt="ShoppinLyst's Nearby Stores map of lower Manhattan, dense with grocery-store pins and distance cards with directions"
            widths={[320, 480, 720]}
            sizes="(min-width: 640px) 300px, 44vw"
          />
        </div>
        <figcaption class="case-caption text-center">Nearby stores, with directions</figcaption>
      </figure>
      <figure class="reveal sm:translate-y-8" style="--reveal-i:1">
        <div class="phone shadow-soft">
          <Image
            src={p.images.addItem!}
            alt="ShoppinLyst Add Item form with name, quantity and unit fields, a priority selector and a notes field"
            widths={[320, 480, 720]}
            sizes="(min-width: 640px) 300px, 44vw"
          />
        </div>
        <figcaption class="case-caption text-center">
          Items carry quantity, unit, priority, notes
        </figcaption>
      </figure>
    </div>
  </CaseSection>

  <CaseSection number="03" label="Spec sheet" width="wide">
    <div class="grid items-start gap-x-14 gap-y-10 lg:grid-cols-2">
      <div class="max-w-md">
        {
          spec.map(([key, value]) => (
            <div class="reveal hairline-t flex items-baseline justify-between gap-6 py-3">
              <span class="font-mono text-[0.7rem] tracking-[0.1em] text-ink-faint uppercase">
                {key}
              </span>
              <span class="text-sm text-ink">{value}</span>
            </div>
          ))
        }
        <p class="case-prose mt-8">
          A grocery app that downloads in under a megabyte is a deliberate constraint: native
          SwiftUI, system frameworks, no bundled analytics, nothing the product doesn’t need.
        </p>
      </div>
      <figure class="reveal mx-auto w-full max-w-[300px]">
        <div class="phone shadow-soft">
          <Image
            src={p.images.appStore!}
            alt="ShoppinLyst's App Store listing: the cart-and-checkmark icon, 'Smarter shopping, less waste', a 5.0 rating from 6 ratings, and the version 2.1 release notes"
            widths={[320, 480, 720]}
            sizes="300px"
          />
        </div>
        <figcaption class="case-caption text-center">
          The listing, as shipped — the rating carries its sample size
        </figcaption>
      </figure>
    </div>
  </CaseSection>

  <CaseSection number="04" label="Why it matters here">
    <p>
      Developer tools forgive a rough edge; consumer software doesn’t. Shipping ShoppinLyst meant
      the other half of engineering: App Store review, release management across versions, MapKit
      and location permissions handled respectfully, and an interface a stranger can use without a
      manual.
    </p>
    <p>
      It is also the one project here whose source stays closed — the product is the artifact. You
      can <a href={p.store}>install it from the App Store</a> and judge it the way its users do.
    </p>
  </CaseSection>
</CaseStudyLayout>

<style>
  .phone {
    border-radius: 2.6rem;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    padding: 0.55rem;
  }

  .phone :global(img) {
    border-radius: 2.05rem;
    display: block;
    width: 100%;
    height: auto;
  }
</style>
